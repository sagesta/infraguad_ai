# ─── Auth ───
INFRAGUARD_USERNAME=admin
INFRAGUARD_PASSWORD=changeme
SECRET_KEY=your-random-secret-key-here
# Set to 1 once the dashboard is served over HTTPS (marks the session cookie Secure)
SESSION_COOKIE_SECURE=0

# ─── LLM provider ───
# Which model API analyzes telemetry: gemini (default), anthropic, openai,
# or ollama (fully self-hosted). Switching provider/model re-opens acknowledged
# conditions automatically because the model is part of the memory fingerprint.
LLM_PROVIDER=gemini

# ─── Gemini Developer API (used when LLM_PROVIDER=gemini) ───
# Create an API key in Google AI Studio. No GCP service account or Vertex IAM role.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ─── Anthropic (used when LLM_PROVIDER=anthropic) ───
ANTHROPIC_API_KEY=
# Claude Sonnet is the balanced frontier option; Haiku is cheaper for frequent checks.
ANTHROPIC_MODEL=claude-sonnet-5

# ─── OpenAI (used when LLM_PROVIDER=openai) ───
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1

# ─── Ollama (used when LLM_PROVIDER=ollama) — the fully self-hosted option ───
# Runs against the "ollama" service in docker-compose.yml. No API key, no
# outbound calls to any provider. After first `docker compose up`, pull a
# model once: docker compose exec ollama ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=llama3.1:8b

# ─── Loki (logs; also feeds the threat scanner) ───
LOKI_URL=http://<GCE_VM_IP>:3100

# ─── Prometheus (metrics) ───
PROMETHEUS_URL=http://prometheus:9090

# ─── HTTP uptime probes (comma-separated URLs) ───
PROBE_URLS=https://yourapp.com,https://api.yourapp.com

# ─── Notifications (ntfy.sh topic; alerts fire on high/critical) ───
NTFY_TOPIC=infraguard-devplanner

# ─── Docker monitoring (optional, off by default) ───
# Set to 1 to scan local container events, gather diagnostics on high/critical
# verdicts, and tail the target container's error logs. Requires the Docker
# socket mount in docker-compose.yml.
ENABLE_DOCKER_MONITORING=0
# Containers to inspect on high/critical severity (comma-separated names)
MONITORED_CONTAINERS=devplanner-api
# Container whose error log lines are tailed each heartbeat
DEVPLANNER_CONTAINER_NAME=devplanner-api
# Docker Engine API endpoint (leave empty for the default unix socket)
DOCKER_HOST=

# ─── SQLite (shared between agent and API in Docker) ───
DB_PATH=/data/verdicts.db
# Verdicts older than this many days are pruned automatically
VERDICT_RETENTION_DAYS=30
# "Mark as known" acknowledgements expire after this many days (0 or less = never)
ACK_TTL_DAYS=30

# ─── Runbooks (for RAG) ───
# Markdown files under this directory are indexed for the runbook Q&A panel.
# Mounted read-only from ./runbooks in docker-compose.yml — nothing external.
# Subdirectories become the "category" metadata (e.g. runbooks/deployment/*.md).
# Embeddings run locally too (ONNX all-MiniLM-L6-v2) — no API key needed.
RUNBOOKS_DIR=/app/runbooks

# ─── CrowdSec (optional — threat bans run in dry-run mode without this) ───
CROWDSEC_API_URL=
CROWDSEC_API_KEY=

# ─── LangChain Agent ───
# Set to 1 to enable LangChain multi-tool reasoning (recommended).
# NOTE: keep comments on their own line — docker compose env_file does not
# strip inline comments, so "USE_LANGCHAIN_AGENT=1  # comment" would break it.
USE_LANGCHAIN_AGENT=1

# ─── Heartbeat ───
# Interval between agent checks in seconds (default: 120)
HEARTBEAT_INTERVAL_SECONDS=120

# ─── Docker images (optional; local builds default to "infraguard/...") ───
REGISTRY=
