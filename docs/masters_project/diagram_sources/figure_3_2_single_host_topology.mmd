      AGENT["Agent container<br/>Scheduled heartbeat"]
    end

    SQLITE[("sqlite_data volume")]
    CHROMA[("chroma_data volume")]
    PROMTAIL["Promtail"]
    LOKI["Loki"]
    PROM["Prometheus"]

    API --- SQLITE
    AGENT --- SQLITE
    API --- CHROMA
    PROMTAIL -->|"Ship logs"| LOKI
    AGENT -->|"Log queries"| LOKI
    AGENT -->|"Metric queries"| PROM
  end

  MODEL["Direct model API"]
  NTFY["ntfy.sh"]
  RUNBOOKS["Local Markdown runbooks"]
  CROWDSEC["CrowdSec LAPI<br/>(optional)"]

  USER <-->|"HTTPS"| API
  API -.->|"Model and embedding requests"| MODEL
  AGENT -.->|"Reasoning request"| MODEL
