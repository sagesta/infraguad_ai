%% Figure 4.2 — Verdict-Memory Fingerprint and Acknowledgement Flow
%% Appears in: Chapter 4, Verdict-Memory
%% Render to: ../fig_4_2_llm_classes.png
flowchart TB
  V["Structured verdict<br/>severity and condition signature"]
  FP["SHA-256 fingerprint<br/>signature + prompt version + model"]
  ROW[("Stored verdict")]
  LOW{"Severity is ok or warning?"}
  MARK["Operator selects Mark known"]
  ACK[("Acknowledgement<br/>fingerprint and optional expiry")]
  NEXT["Next heartbeat loads active acknowledgements"]
  PROMPT["Known conditions are included in prompt"]
  MODEL["Model still analyses fresh telemetry"]
  MATCH{"New fingerprint matches active acknowledgement?"}
  HIDE["Dashboard marks acknowledged<br/>and hides it by default"]
  SHOW["Dashboard surfaces new verdict"]
  HIGH["High and critical always surface"]

  V --> FP --> ROW
  V --> LOW
  LOW -->|"yes"| MARK --> ACK
  LOW -->|"no"| HIGH
  ACK --> NEXT --> PROMPT --> MODEL --> V
  FP --> MATCH
  ACK --> MATCH
  MATCH -->|"yes, low risk"| HIDE
  MATCH -->|"no or changed rules"| SHOW
  HIGH --> SHOW

  NOTE["Acknowledgement reduces repeated display;<br/>it does not skip model calls or remediate the condition"]
  NOTE -.-> HIDE
