<mxfile host="app.diagrams.net" type="device">
  <!-- Figure 3.4 - Use-Case Diagram (Operator and Agent)
       Appears in: Chapter 3, Section 3.4.2 (Use-Case Model)
       Render to: ../fig_3_4_usecase.png  (File > Export as > PNG, 300 DPI) -->
  <diagram name="Figure 3.4 Use-Case">
    <mxGraphModel dx="900" dy="640" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- System boundary -->
        <mxCell id="bnd" value="InfraGuard AI" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="280" y="40" width="300" height="470" as="geometry" />
        </mxCell>

        <!-- Actors -->
        <mxCell id="opA" value="Operator" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="230" width="40" height="90" as="geometry" />
        </mxCell>
        <mxCell id="agA" value="Agent" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="110" width="40" height="90" as="geometry" />
        </mxCell>
        <mxCell id="llmA" value="LLM Provider" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="370" width="40" height="90" as="geometry" />
        </mxCell>

        <!-- Use cases -->
        <mxCell id="uc1" value="View status &amp; verdict" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="320" y="70" width="220" height="48" as="geometry" />
        </mxCell>
        <mxCell id="uc2" value="Acknowledge known condition" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="320" y="130" width="220" height="48" as="geometry" />
        </mxCell>
        <mxCell id="uc3" value="Review &amp; block threat" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="320" y="190" width="220" height="48" as="geometry" />
        </mxCell>
        <mxCell id="uc4" value="Ask runbook assistant" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="320" y="250" width="220" height="48" as="geometry" />
        </mxCell>
        <mxCell id="uc5" value="Re-index runbooks" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="320" y="310" width="220" height="48" as="geometry" />
        </mxCell>
        <mxCell id="uc6" value="Generate verdict (heartbeat)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="320" y="370" width="220" height="48" as="geometry" />
        </mxCell>
        <mxCell id="uc7" value="Send notification" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="320" y="440" width="220" height="48" as="geometry" />
        </mxCell>

        <!-- Operator associations -->
        <mxCell id="e1" style="endArrow=none;html=1;" edge="1" parent="1" source="opA" target="uc1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=none;html=1;" edge="1" parent="1" source="opA" target="uc2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=none;html=1;" edge="1" parent="1" source="opA" target="uc3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="endArrow=none;html=1;" edge="1" parent="1" source="opA" target="uc4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="endArrow=none;html=1;" edge="1" parent="1" source="opA" target="uc5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Agent associations -->
        <mxCell id="e6" style="endArrow=none;html=1;" edge="1" parent="1" source="agA" target="uc6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="endArrow=none;html=1;" edge="1" parent="1" source="agA" target="uc7"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Use-case to external actor -->
        <mxCell id="e8" style="endArrow=none;html=1;" edge="1" parent="1" source="uc6" target="llmA"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
