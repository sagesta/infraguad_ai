%% Figure 3.4 — Use-Case Diagram
%% Appears in: Chapter 3, Use-Case Model
%% Render to: ../fig_3_4_usecase.png
%% Mermaid approximates UML use-case notation. Use the companion draw.io source
%% when strict stick-figure and ellipse notation is required.
flowchart LR
  OP(["Operator"])
  TIMER(["Heartbeat scheduler"])
  LLM(["Configured LLM"])

  subgraph SYSTEM["InfraGuard AI"]
    VIEW(["View current status and history"])
    ACK(["Mark a reviewed condition as known"])
    ASK(["Ask the local runbook assistant"])
    INDEX(["Re-index Markdown runbooks"])
    THREAT(["Review a detected threat"])
    BAN(["Approve CrowdSec IP ban"])
    COLLECT(["Collect telemetry"])
    VERDICT(["Generate and store verdict"])
    ALERT(["Send high or critical alert"])
    MANUAL(["Follow runbook and remediate manually"])
  end

  OP --- VIEW
  OP --- ACK
  OP --- ASK
  OP --- INDEX
  OP --- THREAT
  OP --- BAN
  OP --- MANUAL
  TIMER --- COLLECT
  COLLECT --> VERDICT
  VERDICT --- LLM
  VERDICT --> ALERT
  VIEW --> MANUAL
  ASK --> MANUAL
  THREAT --> BAN
